# dependencies
node_modules/

# Expo
.expo/
dist/
dist-*/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# local runtime data and secrets
.env
.env.*
!.env.example
server/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# local tooling and generated artifacts
.dsh-uploads/
.dsh-vision-router/
workspace-artifacts/
tmp/
.tmp/
.load-capacity-installer-test-*/
output/
figma-poster/

# Local model training workspace and datasets (not application source)
/models/

# deployment build archives (keep deployment scripts/configuration)
deploy/**/*.zip
deploy/**/*.tar.gz
deploy/**/*.tar.gz.*
deploy/**/SHA256SUMS.*
deploy/**/*-web-*/
deploy/**/*-combined-*/
*.apk
*.aab
*.ipa

# Local Python bytecode and Expo configuration backups
__pycache__/
*.py[cod]
app.*.backup.json
app.json.*-backup

# Internal source documents retained locally
/docs/PDF_OCR_全文.md
/docs/需求交接文档-完整版.md

# generated office documents
docs/*.docx

app-example

# Retired recognition resources retained locally, excluded from Git and new EAS builds.
modules/offline-assistant-voice/vendor/
modules/offline-assistant-voice/assets/
