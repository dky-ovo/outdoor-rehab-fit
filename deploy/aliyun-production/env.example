# Copy to a private file outside the release tree, chmod 600; never commit it.
# Blank settings require an explicit deployment decision; no secret is supplied.
RELEASE_TAG=
# Select a reviewed Caddy 2 tag, preferably pin its digest at release time.
CADDY_IMAGE=caddy:2.11.4-alpine
ACME_EMAIL=
# User confirmed ports 80/443 are free; recheck before the actual start.
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443

# Preserve the existing high-entropy production JWT key if sessions must survive.
# A new key invalidates old login tokens. Never use the development fallback.
JWT_SECRET_FILE=/opt/outdoor-fit/production/secrets/jwt-secret
MYSQL_HOST=rm-3nsog7t39ggxq6qkv.rwlb.cnhk.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=outdoor_fit_app
# Store the password as raw UTF-8 in the private file; it is never interpolated.
MYSQL_PASSWORD_FILE=/opt/outdoor-fit/production/secrets/mysql-password
# The dedicated runtime requires this production database and application user.
MYSQL_DATABASE=outdoor_fit_prod
RDS_CA_FILE=/opt/outdoor-fit/production/config/rds-ca-chain.pem

# Existing absolute host directories; bind mounts will not create missing paths.
EQUIPMENT_IMAGES_DIR=/opt/outdoor-fit/production/state/equipment-images
MEDIA_LIBRARY_DIR=/opt/outdoor-fit/production/state/media-library
MEDIA_SEED_DIR=/opt/outdoor-fit/production/state/media-seed
ADMIN_WEB_DIR=/opt/outdoor-fit/production/releases/outdoor-fit-production-20260924-v1/web
CADDY_DATA_DIR=/opt/outdoor-fit/production/state/caddy-data
CADDY_CONFIG_DIR=/opt/outdoor-fit/production/state/caddy-config

# SMS password reset stays disabled until a real provider is activated.
# Account/password login and invitation-code registration remain available.
SMS_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Optional FAQ selector. Keep disabled until the compatible release is verified.
# This private file contains a secret once DASHSCOPE_API_KEY is supplied locally.
# The model value is the confirmed deployment Model Code, not a training job ID.
BAILIAN_FAQ_ENABLED=false
BAILIAN_MODEL_ID=qwen3-14b-1f1a8952705b
BAILIAN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
